{
  "name": "pmaptilescutter",
  "version": "1.0.0",
  "description": "Cut any image into Leaflet/Google-Maps compatible map tiles at multiple zoom levels",
  "keywords": [
    "map-tiles",
    "leaflet",
    "google-maps",
    "image-tiling",
    "tiles",
    "zoom",
    "sharp",
    "cli"
  ],
  "author": "Patrick Weppelmann",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "pmaptilescutter": "bin/index.ts"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patimweb-labs/pMapTilesCutter.git"
  },
  "bugs": {
    "url": "https://github.com/patimweb-labs/pMapTilesCutter/issues"
  },
  "homepage": "https://github.com/patimweb-labs/pMapTilesCutter#readme",
  "scripts": {
    "start": "node bin/index.ts",
    "test": "node --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test 'tests/**/*.test.ts'",
    "test:watch": "node --test --watch 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
